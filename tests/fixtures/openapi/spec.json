{
  "openapi": "3.1.0",
  "info": {
    "title": "ReputeCast API",
    "description": "The ReputeCast HTTP API. Every operation declares the permission it needs (x-permission).",
    "license": { "name": "AGPL-3.0", "url": "https://www.gnu.org/licenses/agpl-3.0.html" },
    "version": "dev"
  },
  "paths": {
    "/api/v1/auth/password": {
      "post": {
        "operationId": "sign-in-password",
        "summary": "Sign in with email and password",
        "tags": ["Sign-in"],
        "security": [{ "session": [] }],
        "x-access": "public",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignInInput" } } },
          "required": true
        },
        "responses": {
          "200": { "description": "OK" },
          "default": {
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } },
            "description": "Error"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace}/sms-campaigns": {
      "get": {
        "operationId": "list-sms-campaigns",
        "summary": "list-sms-campaigns",
        "tags": ["SMS campaigns"],
        "security": [{ "session": [] }, { "bearer": [] }],
        "x-access": "workspace",
        "x-permission": "campaigns:view",
        "parameters": [
          {
            "description": "Workspace slug",
            "in": "path",
            "name": "workspace",
            "required": true,
            "schema": { "pattern": "^[a-z0-9][a-z0-9-]{1,62}$", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SmsCampaignList" } } },
            "description": "OK"
          },
          "default": {
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } },
            "description": "Error"
          }
        }
      },
      "post": {
        "operationId": "create-sms-campaign",
        "summary": "Create an SMS campaign (logged)",
        "description": "Starts a draft.",
        "tags": ["SMS campaigns"],
        "security": [{ "session": [] }],
        "x-access": "workspace",
        "x-permission": "campaigns:edit",
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/api/v1/workspaces/{workspace}/transactional/messages": {
      "post": {
        "operationId": "send-transactional-message",
        "summary": "Send one message with a template's live version",
        "description": "Answers 202 with the message ID and status queued.",
        "tags": ["Transactional messages"],
        "security": [{ "session": [] }, { "bearer": [] }],
        "x-access": "workspace",
        "x-permission": "transactional:send",
        "responses": { "202": { "description": "Accepted" } }
      }
    },
    "/api/v1/workspaces/{workspace}/wordpress/report": {
      "post": {
        "operationId": "wordpress-report",
        "summary": "Report in: plugin, WordPress and PHP versions, the feed and where forms are used",
        "tags": ["WordPress plugin"],
        "security": [{ "bearer": [] }],
        "x-access": "workspace",
        "x-integration": "wordpress",
        "responses": { "204": { "description": "No Content" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Orphan": { "type": "object", "properties": { "unused": { "type": "string" } } },
      "Problem": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "errors": { "items": { "$ref": "#/components/schemas/ErrorDetail" }, "type": "array" }
        }
      },
      "ErrorDetail": { "type": "object", "properties": { "message": { "type": "string" } } },
      "SignInInput": { "type": "object", "properties": { "email": { "type": "string" } } },
      "SmsCampaign": { "type": "object", "properties": { "id": { "type": "string" } } },
      "SmsCampaignList": {
        "type": "object",
        "properties": { "items": { "items": { "$ref": "#/components/schemas/SmsCampaign" }, "type": "array" } }
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "API key (rc_live_…) or MCP agent token (rc_agent_…)",
        "scheme": "bearer",
        "type": "http"
      },
      "session": { "description": "Browser session cookie", "in": "cookie", "name": "rc_session", "type": "apiKey" }
    }
  }
}
