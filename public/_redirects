# Cloudflare Pages redirects: <from> <to> <status>.
# Slugs are never renamed after publishing; when a page must move, add a 301 here.

# The API reference is English only; the language picker on /api/ pages links to /<locale>/api/….
/de/api/* /api/:splat 302
/es/api/* /api/:splat 302
/fr/api/* /api/:splat 302
/vi/api/* /api/:splat 302
