{
  "name": "@reputecast/docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/content/check.ts",
    "lint": "eslint . && prettier --check .",
    "lint:prose": "vale --glob='!src/content/docs/vi/**' src/content/docs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "openapi:sync": "node scripts/upstream/sync-openapi.ts",
    "upstream:check": "node scripts/upstream/check-drift.ts",
    "shots": "node scripts/screenshots/capture.ts",
    "check:links": "node scripts/content/check-links.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/starlight": "0.42.6",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.2",
    "astro-og-canvas": "0.13.2",
    "canvaskit-wasm": "0.42.0",
    "sharp": "0.35.5",
    "starlight-image-zoom": "0.16.2",
    "starlight-links-validator": "0.27.0",
    "starlight-llms-txt": "0.12.0",
    "starlight-openapi": "0.27.0",
    "starlight-sidebar-topics": "0.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.3",
    "yaml": "2.9.1"
  }
}
