---
// Starlight's footer plus a row with the problem-report link, the product sites and the content license.
import Default from '@astrojs/starlight/components/Footer.astro'

const { t } = Astro.locals
const route = Astro.locals.starlightRoute
const canonical = new URL(Astro.url.pathname, Astro.site).href
const title = route.entry.data.title
const issueUrl =
  'https://github.com/HostRepute/ReputeCastDocs/issues/new' +
  `?title=${encodeURIComponent(`Docs: ${title}`)}` +
  `&body=${encodeURIComponent(`Page: ${canonical}\n\nWhat is wrong or missing:\n`)}`
---

<Default {...Astro.props} />
<div class="rc-footer">
  <a href={issueUrl}>{t('rc.footer.report')}</a>
  <a href="https://reputecast.com">{t('rc.footer.website')}</a>
  <a href="https://hostrepute.com">HostRepute</a>
  <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">
    {t('rc.footer.license')}
  </a>
</div>

<style>
  .rc-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
  }
  .rc-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--sl-color-gray-3);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rc-footer a:hover {
    color: var(--sl-color-white);
  }
</style>
