---
// Breadcrumbs (topic › group), the page title and the page meta row.
import PageMeta from '../PageMeta.astro'
import { groupFor, localize, localizedPath, topicFor } from '../../lib/topics.ts'

const route = Astro.locals.starlightRoute
const { lang, entry } = route
const topic = topicFor(route.id)
const group = groupFor(route.id)
---

{topic && (
  <nav class="rc-breadcrumbs" aria-label={Astro.locals.t('rc.breadcrumbs')}>
    <ol>
      <li>
        <a href={localizedPath(topic.link, lang)}>{localize(topic.label, lang)}</a>
      </li>
      {group && localize(group, lang) !== localize(topic.label, lang) && <li>{localize(group, lang)}</li>}
    </ol>
  </nav>
)}
<!-- Skip-link target: focusable so "Skip to content" moves keyboard focus into main. -->
<h1 id="_top" tabindex="-1">
  {entry.data.title}
</h1>
{entry.data.template !== 'splash' && <PageMeta />}

<style>
  .rc-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .rc-breadcrumbs li + li::before {
    content: '›' / '';
    margin-inline-end: 0.5rem;
    color: var(--sl-color-gray-4);
  }
  .rc-breadcrumbs a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  .rc-breadcrumbs a:hover {
    text-decoration: underline;
  }
  h1:focus {
    outline: none;
  }
  h1 {
    margin-top: 0.5rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
</style>
