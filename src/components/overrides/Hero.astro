---
/**
 * The home page hero. Starlight's own Hero crops its image to a 400×400 square, which suits a logo but cuts a
 * screenshot of the app in half. This one keeps Starlight's title, tagline and actions and shows `hero.image`
 * whole underneath, wider than the text column, in a window frame (the image is captured at 2×: the `home-hero`
 * shot in scripts/screenshots/manifest.ts).
 */
import { LinkButton } from '@astrojs/starlight/components'
import { Picture } from 'astro:assets'

const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline, image, actions = [] } = data.hero ?? {}
if (image && !('file' in image)) throw new Error('hero.image must be a file: the home page shows a screenshot')
const file = image && 'file' in image ? image.file : undefined
const alt = image?.alt ?? ''
---

<div class="rc-hero">
  <div class="rc-hero__copy">
    <!-- Skip-link target, as in PageTitle.astro. -->
    <h1 id="_top" tabindex="-1" data-page-title set:html={title} />
    {tagline && <div class="rc-hero__tagline" set:html={tagline} />}
    {actions.length > 0 && (
      <div class="rc-hero__actions">
        {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
          <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
            {text}
            {icon?.html && <Fragment set:html={icon.html} />}
          </LinkButton>
        ))}
      </div>
    )}
  </div>
  {file && (
    <div class="rc-hero__shot">
      <div class="rc-hero__window not-content">
        <Picture
          src={file}
          alt={alt}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 960, 1280, 1920, 2560].filter((w) => w <= file.width)}
          sizes="(min-width: 80rem) 76rem, calc(100vw - 3rem)"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  )}
</div>

<style>
  .rc-hero {
    display: grid;
    /* One column as wide as the text column: the wider shot overflows it evenly instead of widening it. */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    padding-block: clamp(2rem, 1rem + 6vmin, 5rem) 1rem;
  }
  .rc-hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-align: center;
  }
  .rc-hero__copy > * {
    max-width: 40ch;
  }
  h1 {
    margin: 0;
    font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rc-hero__tagline {
    max-width: 52ch;
    font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
    color: var(--sl-color-gray-2);
  }
  .rc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: center;
    margin-top: 0.5rem;
  }
  /* Wider than the text column, centered on it: the app is legible at about 90% of its size on a laptop. */
  .rc-hero__shot {
    position: relative;
    left: 50%;
    width: min(76rem, calc(100vw - 3rem));
    transform: translateX(-50%);
  }
  .rc-hero__shot::before {
    content: '';
    position: absolute;
    inset: 8% 10% -4%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--sl-color-accent), transparent);
    opacity: 0.35;
    filter: blur(48px);
  }
  .rc-hero__window {
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 14px;
    background: var(--sl-color-gray-6);
    box-shadow: 0 28px 70px -24px rgb(0 0 0 / 0.45);
  }
  .rc-hero__window :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
