---
// MCP tools (grouped by area), resources and prompts from src/data/mcp.yaml.
import { pageContext } from '../lib/page-context.ts'
import Heading from './reference/Heading.astro'
import TableScroll from './TableScroll.astro'
import { mcpSections, type HeadingLevel, type Row } from '../lib/catalogs.ts'
import { inline, pick } from '../lib/l10n.ts'

interface Props {
  headingLevel?: HeadingLevel
}

const { headingLevel = 2 } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const sections = await mcpSections(lang, headingLevel)
type Item = Row<'mcp'>
const describe = (item: Item) =>
  inline(pick(item.description, lang), lang) +
  (item.params && item.params.length > 0
    ? `<ul class="rc-params">${item.params
        .map((p) => `<li><code>${p.name}</code>: ${inline(pick(p.description, lang), lang)}</li>`)
        .join('')}</ul>`
    : '')
---

{sections.map((section) => (
  <>
    <Heading heading={section.heading} />
    {section.rows.length > 0 && (
      <TableScroll label={section.heading.text}>
        <table>
          <thead>
            <tr>
              <th scope="col">{t('rc.col.name')}</th>
              <th scope="col">{t('rc.col.description')}</th>
            </tr>
          </thead>
          <tbody>
            {section.rows.map((item) => (
              <tr id={item.id}>
                <th scope="row">
                  <code>{item.id}</code>
                </th>
                <td set:html={describe(item)} />
              </tr>
            ))}
          </tbody>
        </table>
      </TableScroll>
    )}
    {section.children.map((area) => (
      <>
        <Heading heading={area.heading} />
        <TableScroll label={`${section.heading.text}: ${area.heading.text}`}>
          <table>
            <thead>
              <tr>
                <th scope="col">{t('rc.col.name')}</th>
                <th scope="col">{t('rc.col.permission')}</th>
                <th scope="col">{t('rc.col.effect')}</th>
                <th scope="col">{t('rc.col.description')}</th>
              </tr>
            </thead>
            <tbody>
              {area.rows.map((tool) => (
                <tr id={tool.id}>
                  <th scope="row">
                    <code>{tool.id}</code>
                  </th>
                  <td>{tool.permission ? <code>{tool.permission}</code> : '—'}</td>
                  <td>{tool.effect ? t(`rc.effect.${tool.effect}`) : '—'}</td>
                  <td set:html={describe(tool)} />
                </tr>
              ))}
            </tbody>
          </table>
        </TableScroll>
      </>
    ))}
  </>
))}

<style>
  :global(.rc-params) {
    margin-top: 0.25rem;
    font-size: var(--sl-text-sm);
  }
</style>
