---
// Starlight makes every Markdown table its own sideways scroll box. A table that overflows (a phone, a translation's
// longer words) gets tabindex="0" so a keyboard can scroll it, and loses it once it fits: Expressive Code does the
// same for code blocks. A table inside <TableScroll> never overflows itself; that component's region scrolls.
---

<script>
  const tables = [...document.querySelectorAll('.sl-markdown-content table')]

  function update(table: Element): void {
    const overflows = table.scrollWidth > table.clientWidth
    if (overflows && !table.hasAttribute('tabindex')) table.setAttribute('tabindex', '0')
    else if (!overflows && table.hasAttribute('tabindex')) table.removeAttribute('tabindex')
  }

  // A resize (the window, a tab panel or <details> opening) reports the table's box; a web font arriving changes
  // only its content, so that is checked too.
  const observer = new ResizeObserver((entries) => entries.forEach((entry) => update(entry.target)))
  tables.forEach((table) => observer.observe(table))
  document.fonts.addEventListener('loadingdone', () => tables.forEach(update))
</script>
