---
// Renders a menu path from UI label ids (src/data/ui-labels.yaml): **Settings** › **Keys & MCP**.
// Each page shows the app label in its own language when upstream has one, else the English label.
import { pick } from '../lib/l10n.ts'
import { pageContext } from '../lib/page-context.ts'
import { getEntry } from 'astro:content'

interface Props {
  /** Label ids joined by ' > ', e.g. 'nav.settings > settings.keys'. */
  path: string
}

const { path } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const ids = path.split('>').map((s) => s.trim())
const labels = await Promise.all(
  ids.map(async (id) => {
    const entry = await getEntry('uiLabels', id)
    if (!entry) throw new Error(`Unknown UI label "${id}"`)
    return pick(entry.data, lang)
  }),
)
---

<span class="rc-uipath">
  {labels.map((label, i) => (
    <>
      {i > 0 && (
        <>
          <span aria-hidden="true"> › </span>
          <span class="sr-only">, {t('rc.uipath.then')} </span>
        </>
      )}
      <strong>{label}</strong>
    </>
  ))}
</span>
