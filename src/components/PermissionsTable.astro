---
// Every permission key from src/data/permissions.yaml, grouped as in the role editor.
import { pageContext } from '../lib/page-context.ts'
import Heading from './reference/Heading.astro'
import TableScroll from './TableScroll.astro'
import { permissionSections, type HeadingLevel } from '../lib/catalogs.ts'
import { inline, pick } from '../lib/l10n.ts'

interface Props {
  headingLevel?: HeadingLevel
}

const { headingLevel = 2 } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const sections = await permissionSections(lang, headingLevel)
---

{sections.map((section) => (
  <>
    <Heading heading={section.heading} />
    <TableScroll label={`${t('rc.col.permission')}: ${section.heading.text}`}>
      <table>
        <thead>
          <tr>
            <th scope="col">{t('rc.col.key')}</th>
            <th scope="col">{t('rc.col.description')}</th>
            <th scope="col">{t('rc.col.sensitive')}</th>
            <th scope="col">{t('rc.col.holders')}</th>
            <th scope="col">{t('rc.col.includes')}</th>
          </tr>
        </thead>
        <tbody>
          {section.rows.map((p) => (
            <tr id={p.id.replace(':', '-')}>
              <th scope="row">
                <code>{p.id}</code>
              </th>
              <td set:html={inline(pick(p.description, lang), lang)} />
              <td>{p.sensitive ? t('rc.yes') : t('rc.no')}</td>
              <td>{t(`rc.holders.${p.holders}`)}</td>
              <td>
                {p.implies.length > 0
                  ? p.implies.map((key, i) => (
                      <>
                        {i > 0 && ', '}
                        <code>{key}</code>
                      </>
                    ))
                  : '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </TableScroll>
  </>
))}
