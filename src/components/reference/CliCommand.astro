---
import { pageContext } from '../../lib/page-context.ts'
import { Aside, Code } from '@astrojs/starlight/components'
import FlagsTable from './FlagsTable.astro'
import type { Row } from '../../lib/catalogs.ts'
import { inline, pick } from '../../lib/l10n.ts'

interface Props {
  cmd: Row<'cli'>
}

const { cmd } = Astro.props
const { lang, t } = pageContext(Astro.locals)
---

<p set:html={inline(pick(cmd.summary, lang), lang)} />
{cmd.description && <p set:html={inline(pick(cmd.description, lang), lang)} />}
{cmd.devOnly && <Aside type="caution">{t('rc.cli.devOnly')}</Aside>}
<Code code={cmd.command} lang="sh" title={t('rc.cli.usage')} />
{cmd.flags.length > 0 && <FlagsTable flags={cmd.flags} label={`${t('rc.cli.flags')}: reputecast ${cmd.id}`} />}
{cmd.examples.map((ex) => (
  <>
    <p set:html={inline(pick(ex.description, lang), lang)} />
    <Code code={ex.code} lang="sh" />
  </>
))}
