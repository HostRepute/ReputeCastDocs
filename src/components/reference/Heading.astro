---
// A heading produced by a reference component; its id and text match the table-of-contents entry
// that src/routeData.ts adds for it.
import type { Heading } from '../../lib/catalogs.ts'

interface Props {
  heading: Heading
}

const { heading } = Astro.props
const Tag = `h${Math.min(Math.max(heading.depth, 2), 6)}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
---

<Tag id={heading.slug}>{heading.text}</Tag>
