---
// A heading produced by a reference component; its id and text match the table-of-contents entry that
// src/routeData.ts adds for it. On Starlight pages it gets the same anchor link as Markdown headings.
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro'
import type { Heading } from '../../lib/catalogs.ts'
import { pageContext } from '../../lib/page-context.ts'

interface Props {
  heading: Heading
  /** Render the text as code (configuration key prefixes, command names). */
  code?: boolean
}

const { heading, code = false } = Astro.props
const level = Math.min(Math.max(heading.depth, 2), 6) as 2 | 3 | 4 | 5 | 6
const Tag = `h${level}` as const
const { inStarlight } = pageContext(Astro.locals)
---

{inStarlight ? (
  <AnchorHeading level={level} id={heading.slug}>
    {code ? <code>{heading.text}</code> : heading.text}
  </AnchorHeading>
) : (
  <Tag id={heading.slug}>{code ? <code>{heading.text}</code> : heading.text}</Tag>
)}
