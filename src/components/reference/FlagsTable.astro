---
import { pageContext } from '../../lib/page-context.ts'
import TableScroll from '../TableScroll.astro'
import type { Row } from '../../lib/catalogs.ts'
import { inline, pick } from '../../lib/l10n.ts'

interface Props {
  flags: Row<'cli'>['flags']
  label: string
}

const { flags, label } = Astro.props
const { lang, t } = pageContext(Astro.locals)
---

<TableScroll label={label}>
  <table>
    <thead>
      <tr>
        <th scope="col">{t('rc.col.flag')}</th>
        <th scope="col">{t('rc.col.type')}</th>
        <th scope="col">{t('rc.col.default')}</th>
        <th scope="col">{t('rc.col.description')}</th>
      </tr>
    </thead>
    <tbody>
      {flags.map((f) => (
        <tr>
          <th scope="row">
            <code>{f.name}</code>
          </th>
          <td>{f.type}</td>
          <td>{f.default ? <code>{f.default}</code> : '—'}</td>
          <td set:html={inline(pick(f.description, lang), lang)} />
        </tr>
      ))}
    </tbody>
  </table>
</TableScroll>
