---
// Every configuration key from src/data/config.yaml grouped by section, then the environment-only variables.
import { pageContext } from '../lib/page-context.ts'
import Heading from './reference/Heading.astro'
import TableScroll from './TableScroll.astro'
import { configSections, type HeadingLevel } from '../lib/catalogs.ts'
import { inline, pick } from '../lib/l10n.ts'

interface Props {
  headingLevel?: HeadingLevel
}

const { headingLevel = 2 } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const { sections, envOnly, envHeading } = await configSections(lang, headingLevel)
---

{sections.map((section) => (
  <>
    <Heading heading={section.heading} />
    <TableScroll label={`${t('rc.col.key')}: ${section.heading.text}`}>
      <table>
        <thead>
          <tr>
            <th scope="col">{t('rc.col.key')}</th>
            <th scope="col">{t('rc.col.env')}</th>
            <th scope="col">{t('rc.col.default')}</th>
            <th scope="col">{t('rc.col.description')}</th>
          </tr>
        </thead>
        <tbody>
          {section.rows.map((row) => (
            <tr id={row.id}>
              <th scope="row">
                <code>{row.id}</code>
                <span class="rc-type">{row.type}</span>
              </th>
              <td>
                <code>{row.env}</code>
              </td>
              <td>{row.default ? <code>{row.default}</code> : '—'}</td>
              <td set:html={inline(pick(row.description, lang), lang)} />
            </tr>
          ))}
        </tbody>
      </table>
    </TableScroll>
  </>
))}
{envOnly.length > 0 && (
  <>
    <Heading heading={envHeading} />
    <TableScroll label={envHeading.text}>
      <table>
        <thead>
          <tr>
            <th scope="col">{t('rc.col.env')}</th>
            <th scope="col">{t('rc.col.default')}</th>
            <th scope="col">{t('rc.col.description')}</th>
          </tr>
        </thead>
        <tbody>
          {envOnly.map((row) => (
            <tr id={row.id}>
              <th scope="row">
                <code>{row.env}</code>
                <span class="rc-type">{row.type}</span>
              </th>
              <td>{row.default ? <code>{row.default}</code> : '—'}</td>
              <td set:html={inline(pick(row.description, lang), lang)} />
            </tr>
          ))}
        </tbody>
      </table>
    </TableScroll>
  </>
)}

<style>
  .rc-type {
    display: block;
    font-weight: 400;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
