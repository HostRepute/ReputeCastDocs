---
// Capability table for one provider family from src/data/providers.yaml. Columns appear when any row has a value.
// With `id`, renders that one provider's facts as a two-column table (for the provider's own page).
import { pageContext } from '../lib/page-context.ts'
import TableScroll from './TableScroll.astro'
import { rows } from '../lib/catalogs.ts'
import { inline, pick } from '../lib/l10n.ts'
import { localizedPath } from '../lib/topics.ts'

interface Props {
  family: 'email' | 'sms' | 'verification' | 'ai' | 'payments' | 'stores' | 'push' | 'whatsapp' | 'seed' | 'import'
  /** One provider id from providers.yaml, e.g. 'ses'. */
  id?: string
  label?: string
}

const { family, id, label } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const providers = (await rows('providers')).filter((p) => p.family === family && (!id || p.id === id))
if (providers.length === 0) throw new Error(`No providers in family "${family}"${id ? ` with id "${id}"` : ''}`)
const fields = (['kind', 'bulk', 'webhooks', 'domainApi', 'suppressionSync', 'batch'] as const).filter((f) =>
  providers.some((p) => p[f]),
)
const hasNotes = providers.some((p) => p.notes)
const single = id ? providers[0] : undefined
---

{single && (
  <TableScroll label={label ?? single.name}>
    <table class="rc-provider">
      <tbody>
        {fields.map((f) =>
          single[f] ? (
            <tr>
              <th scope="row">{t(`rc.col.${f}`)}</th>
              <td set:html={inline(pick(single[f], lang), lang)} />
            </tr>
          ) : null,
        )}
        {single.notes && (
          <tr>
            <th scope="row">{t('rc.col.notes')}</th>
            <td set:html={inline(pick(single.notes, lang), lang)} />
          </tr>
        )}
      </tbody>
    </table>
  </TableScroll>
)}
{!single && (
  <TableScroll label={label ?? t('rc.col.provider')}>
    <table class:list={['rc-providers', { 'rc-providers--wide': fields.length + (hasNotes ? 1 : 0) > 3 }]}>
      <thead>
        <tr>
          <th scope="col">{t('rc.col.provider')}</th>
          {fields.map((f) => (
            <th scope="col">{t(`rc.col.${f}`)}</th>
          ))}
          {hasNotes && <th scope="col">{t('rc.col.notes')}</th>}
        </tr>
      </thead>
      <tbody>
        {providers.map((p) => (
          <tr>
            <th scope="row">{p.page ? <a href={localizedPath(p.page, lang)}>{p.name}</a> : p.name}</th>
            {fields.map((f) => (
              <td set:html={p[f] ? inline(pick(p[f], lang), lang) : '—'} />
            ))}
            {hasNotes && <td set:html={p.notes ? inline(pick(p.notes, lang), lang) : '—'} />}
          </tr>
        ))}
      </tbody>
    </table>
  </TableScroll>
)}

<style>
  .rc-providers--wide {
    min-width: 62rem;
  }
  .rc-providers td {
    min-width: 7rem;
  }
  .rc-providers td:last-child {
    min-width: 16rem;
  }
</style>
