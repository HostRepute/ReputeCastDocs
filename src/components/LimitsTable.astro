---
// Defaults and limits from src/data/limits.yaml. `area="auto-pause"` renders one area's table without a heading;
// without `area`, every area gets a heading and a table.
import { pageContext } from '../lib/page-context.ts'
import Heading from './reference/Heading.astro'
import TableScroll from './TableScroll.astro'
import { limitSections, type HeadingLevel } from '../lib/catalogs.ts'
import { inline, pick } from '../lib/l10n.ts'

interface Props {
  area?: string
  headingLevel?: HeadingLevel
}

const { area, headingLevel = 2 } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const all = await limitSections(lang, headingLevel)
const sections = area ? all.filter((s) => s.heading.slug === area) : all
if (area && sections.length === 0) throw new Error(`Unknown limits area "${area}"`)
---

{sections.map((section) => (
  <>
    {!area && <Heading heading={section.heading} />}
    <TableScroll label={`${t('rc.col.setting')}: ${section.heading.text}`}>
      <table>
        <thead>
          <tr>
            <th scope="col">{t('rc.col.setting')}</th>
            <th scope="col">{t('rc.col.default')}</th>
            <th scope="col">{t('rc.col.change')}</th>
          </tr>
        </thead>
        <tbody>
          {section.rows.map((r) => (
            <tr>
              <th scope="row" set:html={inline(pick(r.setting, lang), lang)} />
              <td set:html={inline(r.value, lang)} />
              <td set:html={r.change ? inline(pick(r.change, lang), lang) : '—'} />
            </tr>
          ))}
        </tbody>
      </table>
    </TableScroll>
  </>
))}
