---
// Every outgoing webhook event type from src/data/webhook-events.yaml, grouped, with sample payloads.
import { pageContext } from '../lib/page-context.ts'
import { Code } from '@astrojs/starlight/components'
import Heading from './reference/Heading.astro'
import TableScroll from './TableScroll.astro'
import { webhookSections, type HeadingLevel } from '../lib/catalogs.ts'
import { inline, pick } from '../lib/l10n.ts'

interface Props {
  headingLevel?: HeadingLevel
}

const { headingLevel = 2 } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const sections = await webhookSections(lang, headingLevel)
---

{sections.map((section) => (
  <>
    <Heading heading={section.heading} />
    <TableScroll label={`${t('rc.col.event')}: ${section.heading.text}`}>
      <table>
        <thead>
          <tr>
            <th scope="col">{t('rc.col.event')}</th>
            <th scope="col">{t('rc.col.description')}</th>
          </tr>
        </thead>
        <tbody>
          {section.rows.map((e) => (
            <tr id={e.id.replace(/\./g, '-')}>
              <th scope="row">
                <code>{e.id}</code>
              </th>
              <td>
                <span set:html={inline(pick(e.description, lang), lang)} />
                {e.sample && (
                  <details class="rc-sample">
                    <summary>{t('rc.webhooks.sample')}</summary>
                    <Code code={JSON.stringify(JSON.parse(e.sample), null, 2)} lang="json" />
                  </details>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </TableScroll>
  </>
))}

<style>
  .rc-sample {
    margin-top: 0.5rem;
  }
  .rc-sample summary {
    cursor: pointer;
    color: var(--sl-color-text-accent);
  }
</style>
