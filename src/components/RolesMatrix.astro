---
// Which built-in role includes which permission (src/data/roles.yaml × src/data/permissions.yaml).
import { pageContext } from '../lib/page-context.ts'
import TableScroll from './TableScroll.astro'
import { rows } from '../lib/catalogs.ts'
import { pick } from '../lib/l10n.ts'

interface Props {
  /** Limit the columns to roles of one scope. */
  scope?: 'workspace' | 'client' | 'agency'
}

const { scope } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const roles = (await rows('roles')).filter((r) => !scope || r.scope === scope)
const permissions = (await rows('permissions')).filter((p) => roles.some((r) => r.permissions.includes(p.id)))
const held = new Map(roles.map((r) => [r.id, new Set(r.permissions)]))
---

<TableScroll label={`${t('rc.col.role')} × ${t('rc.col.permission')}`}>
  <table class="rc-matrix">
    <thead>
      <tr>
        <th scope="col">{t('rc.col.permission')}</th>
        {roles.map((r) => (
          <th scope="col">{pick(r.name, lang)}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {permissions.map((p) => (
        <tr>
          <th scope="row">
            <code>{p.id}</code>
          </th>
          {roles.map((r) =>
            held.get(r.id)?.has(p.id) ? (
              <td>
                <span aria-hidden="true">✓</span>
                <span class="sr-only">{t('rc.included')}</span>
              </td>
            ) : (
              <td class="rc-matrix__no">
                <span aria-hidden="true">—</span>
                <span class="sr-only">{t('rc.notIncluded')}</span>
              </td>
            ),
          )}
        </tr>
      ))}
    </tbody>
  </table>
</TableScroll>

<style>
  .rc-matrix td {
    text-align: center;
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .rc-matrix td.rc-matrix__no {
    color: var(--sl-color-gray-3);
    font-weight: 400;
  }
  .rc-matrix thead th:not(:first-child) {
    text-align: center;
  }
</style>
