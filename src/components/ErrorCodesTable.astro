---
// API error codes from src/data/api-errors.yaml, grouped by area (or one table with `grouped={false}`).
import { pageContext } from '../lib/page-context.ts'
import Heading from './reference/Heading.astro'
import TableScroll from './TableScroll.astro'
import { errorSections, rows, type HeadingLevel } from '../lib/catalogs.ts'
import { inline, pick } from '../lib/l10n.ts'

interface Props {
  grouped?: boolean
  headingLevel?: HeadingLevel
}

const { grouped = true, headingLevel = 2 } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const sections = grouped
  ? await errorSections(lang, headingLevel)
  : [{ heading: undefined, rows: await rows('apiErrors'), children: [] }]
---

{sections.map((section) => (
  <>
    {section.heading && <Heading heading={section.heading} />}
    <TableScroll label={section.heading ? `${t('rc.col.code')}: ${section.heading.text}` : t('rc.col.code')}>
      <table>
        <thead>
          <tr>
            <th scope="col">{t('rc.col.code')}</th>
            <th scope="col">{t('rc.col.httpStatus')}</th>
            <th scope="col">{t('rc.col.meaning')}</th>
          </tr>
        </thead>
        <tbody>
          {section.rows.map((e) => (
            <tr id={e.id}>
              <th scope="row">
                <code>{e.id}</code>
              </th>
              <td>{e.status}</td>
              <td set:html={inline(pick(e.description, lang), lang)} />
            </tr>
          ))}
        </tbody>
      </table>
    </TableScroll>
  </>
))}
