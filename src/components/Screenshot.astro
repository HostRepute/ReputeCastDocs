---
/**
 * An app screenshot captured by `pnpm shots` (scripts/screenshots/capture.ts) from the upstream demo.
 *
 * Uses src/assets/screenshots/<page locale>/<id>.webp, else the English capture with a note. Numbered markers
 * come from <id>.json; the default slot is the legend (an <ol> matching the marker numbers).
 */
import { pageContext } from '../lib/page-context.ts'
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import { Zoom } from 'starlight-image-zoom/components'
import { badgeSide, type MarkerFile } from '../../scripts/screenshots/lib/markers.ts'
import { shots } from '../../scripts/screenshots/manifest.ts'

interface Props {
  id: string
  /** What the screen shows and why it matters on this page. */
  alt: string
  caption?: string
  /** Load at once with high priority (only for a screenshot above the fold). */
  eager?: boolean
}

const images = import.meta.glob<ImageMetadata>('/src/assets/screenshots/*/*.webp', { eager: true, import: 'default' })
const markerFiles = import.meta.glob<MarkerFile>('/src/assets/screenshots/*/*.json', { eager: true, import: 'default' })

const { id, alt, caption, eager = false } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const own = `/src/assets/screenshots/${lang}/${id}`
const english = `/src/assets/screenshots/en/${id}`
const base = images[`${own}.webp`] ? own : images[`${english}.webp`] ? english : undefined
const shot = shots.find((s) => s.id === id)
if (!base || !shot) throw new Error(`Screenshot "${id}" not found`)
const image = images[`${base}.webp`]!
const markers = markerFiles[`${base}.json`]?.markers ?? []
const englishFallback = base !== own

// Clips are captured at 2× and shown at their own size; phone screens (2×) at phone width; the rest fill the column.
const variant = shot.clip ? 'clip' : shot.viewport === 'mobile' ? 'mobile' : 'wide'
const cssWidth = variant === 'wide' ? image.width : Math.round(image.width / 2)
const candidates = variant === 'wide' ? [720, 1080, 1440] : [cssWidth, image.width]
const widths = [...new Set(candidates.map((w) => Math.min(w, image.width)))]
const sizes = variant === 'wide' ? '(min-width: 72rem) 48rem, 100vw' : `(max-width: ${cssWidth}px) 100vw, ${cssWidth}px`
const hasLegend = Astro.slots.has('default')
---

<figure class="rc-shot" style={variant === 'wide' ? undefined : `--rc-shot-max: ${cssWidth}px`}>
  <div class="rc-shot__frame not-content">
    {/* The canvas has the image's exact aspect ratio, so the markers' percentages land on what they point at. */}
    <div class="rc-shot__canvas" style={`aspect-ratio: ${image.width} / ${image.height}`}>
      <Zoom label={alt}>
        <Picture
          src={image}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={widths}
          sizes={sizes}
          alt={alt}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
        />
      </Zoom>
      {markers.length > 0 && (
        <ol class="rc-shot__markers" aria-hidden="true">
          {markers.map((m) => (
            <li
              data-badge={badgeSide(m, image.width / image.height, shot.markers?.find((d) => d.n === m.n)?.badge)}
              style={`left: ${m.x}%; top: ${m.y}%; width: ${m.w}%; height: ${m.h}%`}
            >
              <span>{m.n}</span>
            </li>
          ))}
        </ol>
      )}
    </div>
  </div>
  {(caption || hasLegend || englishFallback) && (
    <figcaption>
      {caption && <p>{caption}</p>}
      {hasLegend && <slot />}
      {englishFallback && <p class="rc-shot__fallback">{t('rc.shot.englishFallback')}</p>}
    </figcaption>
  )}
</figure>

<style>
  .rc-shot {
    margin-inline: 0;
  }
  .rc-shot__frame {
    max-width: var(--rc-shot-max, 100%);
    margin-inline: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
  }
  .rc-shot__canvas {
    position: relative;
    container-type: inline-size;
    /* Number size: 3.3% of the figure, 18–24 px (lib/markers.ts BADGE_ROOM assumes it). */
    --rc-badge: clamp(18px, 3.3cqi, 24px);
    --rc-badge-gap: 3px;
    --rc-marker: #0f766e;
  }
  .rc-shot__canvas :global(starlight-image-zoom-zoomable),
  .rc-shot__canvas :global(picture) {
    display: block;
    height: 100%;
  }
  .rc-shot__canvas :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 9px;
  }
  /* The plugin's zoom button (visible on keyboard focus) stays above the markers. */
  .rc-shot__canvas :global(.starlight-image-zoom-control) {
    z-index: 2;
  }
  .rc-shot__markers {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .rc-shot__markers li {
    position: absolute;
    box-sizing: border-box;
    margin: 0;
    border: 2px solid var(--rc-marker);
    border-radius: 6px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.75);
  }
  .rc-shot__markers span {
    position: absolute;
    display: grid;
    place-items: center;
    width: var(--rc-badge);
    height: var(--rc-badge);
    border-radius: 50%;
    background: var(--rc-marker);
    box-shadow: 0 0 0 2px #ffffff;
    color: #ffffff;
    font-size: calc(var(--rc-badge) * 0.52);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  /*
   * Beside a box the number lines up with its top edge (or its bottom edge for `-end`), or its middle when the box
   * is shorter than the number; above or below a box, with its left edge (or its right edge for `-end`).
   */
  li[data-badge^='left'] span,
  li[data-badge^='right'] span {
    top: min(0px, calc(50% - var(--rc-badge) / 2));
  }
  li[data-badge='left-end'] span,
  li[data-badge='right-end'] span {
    top: auto;
    bottom: min(0px, calc(50% - var(--rc-badge) / 2));
  }
  li[data-badge^='left'] span {
    right: calc(100% + var(--rc-badge-gap));
  }
  li[data-badge^='right'] span {
    left: calc(100% + var(--rc-badge-gap));
  }
  li[data-badge^='top'] span {
    bottom: calc(100% + var(--rc-badge-gap));
    left: 0;
  }
  li[data-badge^='bottom'] span {
    top: calc(100% + var(--rc-badge-gap));
    left: 0;
  }
  li[data-badge='top-end'] span,
  li[data-badge='bottom-end'] span {
    left: auto;
    right: 0;
  }
  li[data-badge='inside'] span {
    top: 4px;
    left: 4px;
  }
  figcaption {
    max-width: var(--rc-shot-max, 100%);
    margin: 0.5rem auto 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  figcaption > :global(* + *) {
    margin-top: 0.5rem;
  }
  /* The legend's numbers look like the markers' numbers. */
  .rc-shot figcaption :global(ol) {
    padding-inline-start: 0;
    list-style: none;
    counter-reset: rc-legend;
  }
  .rc-shot figcaption :global(ol > li) {
    position: relative;
    padding-inline-start: 2rem;
    counter-increment: rc-legend;
  }
  .rc-shot figcaption :global(ol > li::before) {
    content: counter(rc-legend);
    position: absolute;
    inset-inline-start: 0;
    top: 0.1em;
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    background: #0f766e;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rc-shot__fallback {
    color: var(--sl-color-gray-3);
    font-style: italic;
  }
</style>
