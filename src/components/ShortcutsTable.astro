---
// Keyboard shortcuts from src/data/shortcuts.yaml: app-wide (`app.*`) and composer (`composer.*`) tables.
// Each `keys` item is one keystroke; several items are pressed one after the other.
import { pageContext } from '../lib/page-context.ts'
import TableScroll from './TableScroll.astro'
import { rows } from '../lib/catalogs.ts'
import { groupBy, pick } from '../lib/l10n.ts'

const { lang, t } = pageContext(Astro.locals)
const groups = groupBy(await rows('shortcuts'), (s) => s.id.split('.')[0])
---

{groups.map(({ key, rows: shortcuts }) => (
  <TableScroll label={t(`rc.shortcuts.${key}`)}>
    <table>
      <caption>{t(`rc.shortcuts.${key}`)}</caption>
      <thead>
        <tr>
          <th scope="col">{t('rc.col.keys')}</th>
          <th scope="col">{t('rc.col.action')}</th>
        </tr>
      </thead>
      <tbody>
        {shortcuts.map((s) => (
          <tr>
            <th scope="row">
              {s.keys.map((k, i) => (
                <>
                  {i > 0 && ` ${t('rc.uipath.then')} `}
                  <kbd>{k}</kbd>
                </>
              ))}
            </th>
            <td>{pick(s.action, lang)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </TableScroll>
))}

<style>
  caption {
    text-align: start;
    font-weight: 600;
    padding-bottom: 0.5rem;
    color: var(--sl-color-white);
  }
</style>
