---
// Every `reputecast` command from src/data/cli.yaml: usage, flags and examples.
// Full mode renders one heading per top-level command and per subcommand, then the global flags.
// `command="user"` renders one top-level command under a heading the page writes itself.
import { pageContext } from '../lib/page-context.ts'
import CliCommand from './reference/CliCommand.astro'
import FlagsTable from './reference/FlagsTable.astro'
import Heading from './reference/Heading.astro'
import { cliSections, type HeadingLevel } from '../lib/catalogs.ts'

interface Props {
  command?: string
  headingLevel?: HeadingLevel
}

const { command, headingLevel = 2 } = Astro.props
const { lang, t } = pageContext(Astro.locals)
const { sections, global, globalHeading } = await cliSections(lang, command ? 2 : headingLevel)
const selected = command ? sections.filter((s) => s.heading.slug === command) : sections
if (command && selected.length === 0) throw new Error(`Unknown CLI command "${command}"`)
---

{selected.map((section) => (
  <>
    {!command && <Heading heading={section.heading} />}
    {section.rows.map((cmd) => (
      <CliCommand cmd={cmd} />
    ))}
    {section.children.map((child) => (
      <>
        <Heading heading={child.heading} />
        {child.rows.map((cmd) => (
          <CliCommand cmd={cmd} />
        ))}
      </>
    ))}
  </>
))}
{!command && global && (
  <>
    <Heading heading={globalHeading} />
    <p>{t('rc.cli.globalNote')}</p>
    <FlagsTable flags={global.flags} label={t('rc.cli.global')} />
  </>
)}
