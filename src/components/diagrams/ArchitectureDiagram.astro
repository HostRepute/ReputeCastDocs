---
import { pageContext } from '../../lib/page-context.ts'
// How a ReputeCast instance is built: one binary with web, MCP, ingest and worker roles, PostgreSQL and the
// sending providers (upstream README "How it works"). Labels follow the page language; pass `labels` to override.
interface Labels {
  title: string
  binary: string
  browser: string
  browserSub: string
  agents: string
  agentsSub: string
  inbound: string
  inboundSub: string
  web: string
  webSub: string
  mcp: string
  mcpSub: string
  ingest: string
  ingestSub: string
  worker: string
  workerSub1: string
  workerSub2: string
  postgres: string
  postgresSub: string
  outbound: string
  outboundSub: string
}

interface Props {
  labels?: Partial<Labels>
}

const defaults: Record<'en' | 'vi', Labels> = {
  en: {
    title: 'ReputeCast architecture: one binary, PostgreSQL and your sending providers',
    binary: 'reputecast (single binary)',
    browser: 'Browser',
    browserSub: 'HTTPS',
    agents: 'AI agents',
    agentsSub: 'MCP clients',
    inbound: 'Sending providers',
    inboundSub: 'event webhooks',
    web: 'Web role',
    webSub: 'App · REST API · public pages',
    mcp: 'MCP server',
    mcpSub: 'permission-checked tools',
    ingest: 'Ingest role',
    ingestSub: '/hooks/… → verify → store raw → 200',
    worker: 'Worker role (jobs queued in PostgreSQL)',
    workerSub1: 'Sends · event normalization · suppression sync · health checks',
    workerSub2: 'Warm-up · automations · imports · reports · retention',
    postgres: 'PostgreSQL',
    postgresSub: 'data, jobs, audit log',
    outbound: 'Sending providers',
    outboundSub: 'SES, Postmark, Postal, SMTP, …',
  },
  vi: {
    title: 'Kiến trúc ReputeCast: một tệp nhị phân, PostgreSQL và các nhà cung cấp gửi thư của bạn',
    binary: 'reputecast (một tệp nhị phân duy nhất)',
    browser: 'Trình duyệt',
    browserSub: 'HTTPS',
    agents: 'Tác tử AI',
    agentsSub: 'ứng dụng MCP',
    inbound: 'Nhà cung cấp gửi thư',
    inboundSub: 'webhook sự kiện',
    web: 'Vai trò web',
    webSub: 'Ứng dụng · REST API · trang công khai',
    mcp: 'Máy chủ MCP',
    mcpSub: 'công cụ có kiểm tra quyền',
    ingest: 'Vai trò ingest',
    ingestSub: '/hooks/… → xác minh → lưu bản gốc → 200',
    worker: 'Vai trò worker (tác vụ xếp hàng trong PostgreSQL)',
    workerSub1: 'Gửi thư · chuẩn hóa sự kiện · đồng bộ chặn gửi · kiểm tra tình trạng',
    workerSub2: 'Khởi động · tự động hóa · nhập liên hệ · báo cáo · lưu giữ dữ liệu',
    postgres: 'PostgreSQL',
    postgresSub: 'dữ liệu, tác vụ, nhật ký kiểm tra',
    outbound: 'Nhà cung cấp gửi thư',
    outboundSub: 'SES, Postmark, Postal, SMTP, …',
  },
}

const lang = pageContext(Astro.locals).lang === 'vi' ? 'vi' : 'en'
const l = { ...defaults[lang], ...Astro.props.labels }
const id = 'rc-arch'
---

<figure class="rc-diagram">
  <svg viewBox="0 0 760 470" role="img" aria-labelledby={`${id}-title`} xmlns="http://www.w3.org/2000/svg">
    <title id={`${id}-title`}>{l.title}</title>
    <defs>
      <marker
        id={`${id}-arrow`}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" class="rc-d-arrowhead"></path>
      </marker>
    </defs>

    <rect x="200" y="10" width="550" height="330" rx="12" class="rc-d-frame"></rect>
    <text x="220" y="36" class="rc-d-label">
      {l.binary}
    </text>

    <rect x="220" y="52" width="510" height="54" rx="8" class="rc-d-role"></rect>
    <text x="236" y="75" class="rc-d-strong">
      {l.web}
    </text>
    <text x="236" y="95" class="rc-d-sub">
      {l.webSub}
    </text>

    <rect x="220" y="118" width="510" height="54" rx="8" class="rc-d-role"></rect>
    <text x="236" y="141" class="rc-d-strong">
      {l.mcp}
    </text>
    <text x="236" y="161" class="rc-d-sub">
      {l.mcpSub}
    </text>

    <rect x="220" y="184" width="510" height="54" rx="8" class="rc-d-role"></rect>
    <text x="236" y="207" class="rc-d-strong">
      {l.ingest}
    </text>
    <text x="236" y="227" class="rc-d-sub">
      {l.ingestSub}
    </text>

    <rect x="220" y="250" width="510" height="76" rx="8" class="rc-d-role"></rect>
    <text x="236" y="273" class="rc-d-strong">
      {l.worker}
    </text>
    <text x="236" y="293" class="rc-d-sub">
      {l.workerSub1}
    </text>
    <text x="236" y="313" class="rc-d-sub">
      {l.workerSub2}
    </text>

    <rect x="10" y="52" width="160" height="54" rx="8" class="rc-d-actor"></rect>
    <text x="24" y="75" class="rc-d-strong">
      {l.browser}
    </text>
    <text x="24" y="95" class="rc-d-sub">
      {l.browserSub}
    </text>

    <rect x="10" y="118" width="160" height="54" rx="8" class="rc-d-actor"></rect>
    <text x="24" y="141" class="rc-d-strong">
      {l.agents}
    </text>
    <text x="24" y="161" class="rc-d-sub">
      {l.agentsSub}
    </text>

    <rect x="10" y="184" width="160" height="54" rx="8" class="rc-d-actor"></rect>
    <text x="24" y="207" class="rc-d-strong">
      {l.inbound}
    </text>
    <text x="24" y="227" class="rc-d-sub">
      {l.inboundSub}
    </text>

    <line x1="170" y1="79" x2="218" y2="79" class="rc-d-line" marker-end={`url(#${id}-arrow)`}></line>
    <line x1="170" y1="145" x2="218" y2="145" class="rc-d-line" marker-end={`url(#${id}-arrow)`}></line>
    <line x1="170" y1="211" x2="218" y2="211" class="rc-d-line" marker-end={`url(#${id}-arrow)`}></line>

    <rect x="220" y="390" width="240" height="64" rx="8" class="rc-d-actor"></rect>
    <text x="236" y="416" class="rc-d-strong">
      {l.postgres}
    </text>
    <text x="236" y="438" class="rc-d-sub">
      {l.postgresSub}
    </text>

    <rect x="490" y="390" width="240" height="64" rx="8" class="rc-d-actor"></rect>
    <text x="506" y="416" class="rc-d-strong">
      {l.outbound}
    </text>
    <text x="506" y="438" class="rc-d-sub">
      {l.outboundSub}
    </text>

    <line
      x1="340"
      y1="342"
      x2="340"
      y2="388"
      class="rc-d-line"
      marker-start={`url(#${id}-arrow)`}
      marker-end={`url(#${id}-arrow)`}
    ></line>
    <line x1="610" y1="326" x2="610" y2="388" class="rc-d-line" marker-end={`url(#${id}-arrow)`}></line>
  </svg>
</figure>

<style>
  .rc-diagram {
    margin: 1.5rem 0;
  }
  .rc-diagram svg {
    display: block;
    width: 100%;
    height: auto;
    max-width: 760px;
    font-family: var(--sl-font);
  }
  .rc-d-frame {
    fill: none;
    stroke: var(--sl-color-gray-4);
    stroke-dasharray: 6 4;
  }
  .rc-d-role {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
  }
  .rc-d-actor {
    fill: none;
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  .rc-d-line {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
  .rc-d-arrowhead {
    fill: var(--sl-color-gray-3);
  }
  .rc-d-label {
    font-size: 13px;
    fill: var(--sl-color-gray-3);
  }
  .rc-d-strong {
    font-size: 14px;
    font-weight: 600;
    fill: var(--sl-color-white);
  }
  .rc-d-sub {
    font-size: 12.5px;
    fill: var(--sl-color-gray-2);
  }
</style>
