---
import { pageContext } from '../../lib/page-context.ts'
// Guarded sending: Send Readiness → routing → sending providers → delivery events back through webhooks →
// thresholds → auto-pause or keep sending (resume returns to routing). Labels follow the page language.
interface Labels {
  title: string
  readiness: string
  readinessSub: string
  route: string
  routeSub: string
  providers: string
  providersSub: string
  events: string
  eventsSub: string
  thresholds: string
  thresholdsSub: string
  pause: string
  pauseSub: string
  resume: string
}

interface Props {
  labels?: Partial<Labels>
}

const defaults: Record<'en' | 'vi', Labels> = {
  en: {
    title: 'Guarded sending: checks before the send, then thresholds on live delivery events while it runs',
    readiness: 'Send Readiness',
    readinessSub: 'checks before the send starts',
    route: 'Routing',
    routeSub: 'picks a provider per recipient',
    providers: 'Sending providers',
    providersSub: 'deliver the messages',
    events: 'Delivery events',
    eventsSub: 'come back through webhooks',
    thresholds: 'Thresholds',
    thresholdsSub: 'bounces, complaints, deferrals',
    pause: 'Auto-pause',
    pauseSub: 'or keep sending',
    resume: 'Resume',
  },
  vi: {
    title: 'Gửi có bảo vệ: kiểm tra trước khi gửi, rồi theo dõi ngưỡng trên sự kiện gửi thư trong lúc gửi',
    readiness: 'Độ sẵn sàng gửi',
    readinessSub: 'kiểm tra trước khi bắt đầu gửi',
    route: 'Định tuyến',
    routeSub: 'chọn nhà cung cấp cho từng người nhận',
    providers: 'Nhà cung cấp gửi thư',
    providersSub: 'chuyển thư đi',
    events: 'Sự kiện gửi thư',
    eventsSub: 'trả về qua webhook',
    thresholds: 'Ngưỡng',
    thresholdsSub: 'thư bị trả lại, khiếu nại, trì hoãn',
    pause: 'Tự tạm dừng',
    pauseSub: 'hoặc tiếp tục gửi',
    resume: 'Tiếp tục',
  },
}

const lang = pageContext(Astro.locals).lang === 'vi' ? 'vi' : 'en'
const l = { ...defaults[lang], ...Astro.props.labels }
const id = 'rc-sendflow'
const boxes = [
  { x: 10, y: 20, title: l.readiness, sub: l.readinessSub, accent: true },
  { x: 265, y: 20, title: l.route, sub: l.routeSub, accent: false },
  { x: 520, y: 20, title: l.providers, sub: l.providersSub, accent: false },
  { x: 520, y: 170, title: l.events, sub: l.eventsSub, accent: false },
  { x: 265, y: 170, title: l.thresholds, sub: l.thresholdsSub, accent: false },
  { x: 10, y: 170, title: l.pause, sub: l.pauseSub, accent: true },
]
---

<figure class="rc-diagram">
  <svg viewBox="0 0 760 250" role="img" aria-labelledby={`${id}-title`} xmlns="http://www.w3.org/2000/svg">
    <title id={`${id}-title`}>{l.title}</title>
    <defs>
      <marker
        id={`${id}-arrow`}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" class="rc-d-arrowhead"></path>
      </marker>
    </defs>
    {boxes.map((b) => (
      <g>
        <rect x={b.x} y={b.y} width="230" height="62" rx="8" class={b.accent ? 'rc-d-role' : 'rc-d-actor'} />
        <text x={b.x + 14} y={b.y + 26} class="rc-d-strong">
          {b.title}
        </text>
        <text x={b.x + 14} y={b.y + 47} class="rc-d-sub">
          {b.sub}
        </text>
      </g>
    ))}
    <line x1="240" y1="51" x2="263" y2="51" class="rc-d-line" marker-end={`url(#${id}-arrow)`}></line>
    <line x1="495" y1="51" x2="518" y2="51" class="rc-d-line" marker-end={`url(#${id}-arrow)`}></line>
    <line x1="635" y1="82" x2="635" y2="168" class="rc-d-line" marker-end={`url(#${id}-arrow)`}></line>
    <line x1="520" y1="201" x2="497" y2="201" class="rc-d-line" marker-end={`url(#${id}-arrow)`}></line>
    <line x1="265" y1="201" x2="242" y2="201" class="rc-d-line" marker-end={`url(#${id}-arrow)`}></line>
    <path d="M125 168 L125 125 L380 125 L380 84" class="rc-d-loop" marker-end={`url(#${id}-arrow)`}></path>
    <text x="140" y="118" class="rc-d-sub">
      {l.resume}
    </text>
  </svg>
</figure>

<style>
  .rc-diagram {
    margin: 1.5rem 0;
  }
  .rc-diagram svg {
    display: block;
    width: 100%;
    height: auto;
    max-width: 760px;
    font-family: var(--sl-font);
  }
  .rc-d-role {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
  }
  .rc-d-actor {
    fill: none;
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  .rc-d-line {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
  .rc-d-loop {
    fill: none;
    stroke: var(--sl-color-text-accent);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .rc-d-arrowhead {
    fill: var(--sl-color-gray-3);
  }
  .rc-d-strong {
    font-size: 14px;
    font-weight: 600;
    fill: var(--sl-color-white);
  }
  .rc-d-sub {
    font-size: 12.5px;
    fill: var(--sl-color-gray-2);
  }
</style>
