---
// Wraps tables so they scroll inside their own focusable region instead of the page (WCAG 1.4.10 reflow).
interface Props {
  label: string
  /**
   * Cells wrap as in any other table, so the table only scrolls when the screen is too narrow for what can't wrap
   * (long code, a translation's long words). Without it, headers and code stay on one line and a wide table scrolls.
   */
  wrap?: boolean
}
const { label, wrap = false } = Astro.props
---

<div class:list={['rc-table-scroll', { 'rc-table-wrap': wrap }]} role="region" tabindex="0" aria-label={label}>
  <slot />
</div>

<style>
  .rc-table-scroll {
    position: relative;
    max-width: 100%;
    overflow-x: auto;
    margin-block: 1rem;
  }
  /* Starlight makes every prose table its own scroll box; here the labelled, focusable wrapper scrolls instead. */
  .rc-table-scroll :global(table) {
    display: table;
    overflow: visible;
    margin: 0;
  }
  .rc-table-scroll:not(.rc-table-wrap) :global(th) {
    white-space: nowrap;
  }
  .rc-table-scroll:not(.rc-table-wrap) :global(td code) {
    white-space: nowrap;
  }
</style>
