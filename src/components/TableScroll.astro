---
// Wraps wide tables so they scroll inside their own focusable region instead of the page (WCAG 1.4.10 reflow).
interface Props {
  label: string
}
const { label } = Astro.props
---

<div class="rc-table-scroll" role="region" tabindex="0" aria-label={label}>
  <slot />
</div>

<style>
  .rc-table-scroll {
    max-width: 100%;
    overflow-x: auto;
    margin-block: 1rem;
  }
  .rc-table-scroll :global(table) {
    margin: 0;
  }
  .rc-table-scroll :global(th) {
    white-space: nowrap;
  }
  .rc-table-scroll :global(td code) {
    overflow-wrap: anywhere;
  }
</style>
