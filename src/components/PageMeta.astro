---
// One compact row under the page title: page type, audience, required permissions, where the screen lives.
const { data } = Astro.locals.starlightRoute.entry
const { t } = Astro.locals
const type = data.type
const audience = data.audience ?? []
const permissions = data.permissions ?? []
const uiPath = data.uiPath
const hasDetails = audience.length > 0 || permissions.length > 0 || Boolean(uiPath)
---

{(type || hasDetails) && (
  <div class="rc-meta">
    {type && <span class="rc-meta__type">{t(`rc.type.${type}`)}</span>}
    {hasDetails && (
      <dl>
        {audience.length > 0 && (
          <div>
            <dt>{t('rc.meta.for')}:</dt>
            <dd>{audience.map((a) => t(`rc.audience.${a}`)).join(', ')}</dd>
          </div>
        )}
        {permissions.length > 0 && (
          <div>
            <dt>{t('rc.meta.permissions')}:</dt>
            <dd>
              {permissions.map((key, i) => (
                <>
                  {i > 0 && ', '}
                  <code>{key}</code>
                </>
              ))}
            </dd>
          </div>
        )}
        {uiPath && (
          <div>
            <dt>{t('rc.meta.where')}:</dt>
            <dd>{uiPath}</dd>
          </div>
        )}
      </dl>
    )}
  </div>
)}

<style>
  .rc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .rc-meta__type {
    display: inline-flex;
    align-items: center;
    padding: 0 0.5rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    font-weight: 600;
    font-size: var(--sl-text-xs);
    line-height: 1.6;
    color: var(--sl-color-text-accent);
  }
  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
  }
  dl > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  dt {
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  dd {
    margin: 0;
  }
  code {
    font-size: 0.85em;
  }
</style>
