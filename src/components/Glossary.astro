---
// Glossary from src/data/glossary.yaml, sorted alphabetically in the page language. Anchors = entry ids.
import { pageContext } from '../lib/page-context.ts'
import { rows } from '../lib/catalogs.ts'
import { inline, pick } from '../lib/l10n.ts'
import { localizedPath } from '../lib/topics.ts'

const { lang } = pageContext(Astro.locals)
const terms = (await rows('glossary'))
  .map((g) => ({ ...g, label: pick(g.term, lang) }))
  .sort((a, b) => a.label.localeCompare(b.label, lang, { sensitivity: 'base' }))
---

<dl class="rc-glossary">
  {terms.map((g) => (
    <>
      <dt id={g.id}>{g.link ? <a href={localizedPath(g.link, lang)}>{g.label}</a> : g.label}</dt>
      <dd set:html={inline(pick(g.definition, lang), lang)} />
    </>
  ))}
</dl>

<style>
  .rc-glossary dt {
    margin-top: 1.25rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rc-glossary dd {
    margin: 0.25rem 0 0;
  }
</style>
